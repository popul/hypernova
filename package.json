{
  "name": "hypernova",
  "version": "1.0.0",
  "description": "HYPERNOVA — shoot'em up spatial 3D : vagues d'ennemis, crédits, boutique d'améliorations, campagnes. Three.js + Vite.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{js,css}\" index.html",
    "format:check": "prettier --check \"src/**/*.{js,css}\" index.html",
    "api": "node server/index.js",
    "dev:2": "vite --port 5174",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "keywords": [
    "game",
    "threejs",
    "galaga",
    "shmup",
    "arcade"
  ],
  "author": "Paul Musso",
  "license": "MIT",
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6",
    "vite": "^8.2.2"
  }
}
